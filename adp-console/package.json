{
  "name": "@local/adp-console",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Browse published Tencent Cloud ADP agent apps, publish or unpublish them, and talk to an enabled app from the panel or by @-mentioning it in a session.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/entry.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "dependencies": {
    "tencentcloud-sdk-nodejs-adp": "^4.1.316"
  }
}
